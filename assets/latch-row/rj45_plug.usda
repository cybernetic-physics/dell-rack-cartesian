#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def "Materials"
    {
        def Material "steel"
        {
            token outputs:surface.connect = </World/Materials/steel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.39, 0.43, 0.48)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

