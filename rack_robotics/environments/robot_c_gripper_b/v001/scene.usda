                float physxCollision:contactOffset = 0.00005
                float physxCollision:restOffset = 0
                double size = 1
                float3 xformOp:scale = (0.04, 0.04, 0.98)
                double3 xformOp:translate = (-0.26, 0.735, 1.45)
