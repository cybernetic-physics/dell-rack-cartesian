        def "Joints"
        {
            def PhysicsFixedJoint "RackMount" (
                prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
            )
            {
                rel physics:body1 = </World/Robot/Frame>
                bool physxArticulation:enabledSelfCollisions = 1
                int physxArticulation:solverPositionIterationCount = 128
                int physxArticulation:solverVelocityIterationCount = 4
            }

            def PhysicsPrismaticJoint "Lift" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear"]
            )
            {
                float drive:linear:physics:damping = 0
                float drive:linear:physics:maxForce = 0
                float drive:linear:physics:stiffness = 0
                float drive:linear:physics:targetPosition = 0
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "Z"
                rel physics:body0 = </World/Robot/Frame>
                rel physics:body1 = </World/Robot/Bridge>
                bool physics:collisionEnabled = 0
                point3f physics:localPos0 = (0, 0.72, 1.8)
                point3f physics:localPos1 = (0, 0, 0)
                float physics:lowerLimit = -0.7
                float physics:upperLimit = 0
            }

            def PhysicsPrismaticJoint "Traverse" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear"]
            )
            {
                float drive:linear:physics:damping = 0
                float drive:linear:physics:maxForce = 0
                float drive:linear:physics:stiffness = 0
                float drive:linear:physics:targetPosition = 0.15
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </World/Robot/Bridge>
                rel physics:body1 = </World/Robot/Carriage>
                bool physics:collisionEnabled = 0
                point3f physics:localPos0 = (0, -0.04, 0)
                point3f physics:localPos1 = (0, 0, 0)
