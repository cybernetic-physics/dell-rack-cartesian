                uniform token physics:axis = "X"
                rel physics:body0 = </World/Robot/LiftCarriage>
                rel physics:body1 = </World/Robot/MiddleBoom>
                bool physics:collisionEnabled = 0
                point3f physics:localPos0 = (0, -0.05, 0)
                point3f physics:localPos1 = (0, 0, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.2
                float state:linear:physics:position = 0.03
                float state:linear:physics:velocity = 0
            }

            def PhysicsPrismaticJoint "InnerExtension" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            )
            {
                float drive:linear:physics:damping = 300
                float drive:linear:physics:maxForce = 35
                float drive:linear:physics:stiffness = 100000
                float drive:linear:physics:targetPosition = 0.03
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </World/Robot/MiddleBoom>
                rel physics:body1 = </World/Robot/Carriage>
                bool physics:collisionEnabled = 0
                point3f physics:localPos0 = (0, -0.05, 0)
                point3f physics:localPos1 = (0, 0, 0)
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.2
                float state:linear:physics:position = 0.03
                float state:linear:physics:velocity = 0
            }

            def PhysicsPrismaticJoint "Insertion" (
                prepend apiSchemas = ["PhysicsDriveAPI:linear"]
            )
