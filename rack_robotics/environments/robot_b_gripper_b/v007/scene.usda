    over "Materials"
    {
        def Material "RobotSteel"
        {
            token outputs:surface.connect = </World/Materials/RobotSteel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.48, 0.54, 0.6)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.23
                token outputs:surface
            }
        }

        def Material "RobotAnodized"
        {
            token outputs:surface.connect = </World/Materials/RobotAnodized/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.07, 0.12, 0.16)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "RobotBlue"
        {
            token outputs:surface.connect = </World/Materials/RobotBlue/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
