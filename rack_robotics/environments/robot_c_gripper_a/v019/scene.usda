    over "Materials"
    {
        def Material "RobotSteel"
        {
            token outputs:surface.connect = </World/Materials/RobotSteel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.48, 0.54, 0.6)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.23
                token outputs:surface
            }
        }

        def Material "RobotAnodized"
        {
            token outputs:surface.connect = </World/Materials/RobotAnodized/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.07, 0.12, 0.16)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "RobotBlue"
        {
            token outputs:surface.connect = </World/Materials/RobotBlue/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.21, 0.36)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "RobotTongue"
        {
            token outputs:surface.connect = </World/Materials/RobotTongue/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.94, 0.32, 0.03)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "RobotPad" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </World/Materials/RobotPad/Surface.outputs:surface>
            float physics:dynamicFriction = 0.6
            float physics:restitution = 0
            float physics:staticFriction = 0.7

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.035, 0.04)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }

    over "Physics" (
        prepend apiSchemas = ["PhysxSceneAPI"]
