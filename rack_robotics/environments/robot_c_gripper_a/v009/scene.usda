#usda 1.0
(
    subLayers = [
        @../v007/scene.usda@,
        @cameras.usda@
    ]
)

over "Render"
{
    over "OmniverseKit"
    {
        over "HydraTextures"
        {
            over "omni_kit_widget_viewport_ViewportTexture_0"
            {
                rel camera = </OmniverseKit_Persp>
                rel orderedVars = </Render/Vars/LdrColor>
                custom bool overrideClipRange = 0
                uniform int2 resolution = (1280, 800)
            }
        }
    }
}

over "World"
{
    over "HandDrive" (
        prepend apiSchemas = ["PhysicsDriveAPI:transX", "PhysicsDriveAPI:transY", "PhysicsDriveAPI:transZ", "PhysicsDriveAPI:rotX", "PhysicsDriveAPI:rotY", "PhysicsDriveAPI:rotZ"]
    )
    {
        float drive:rotX:physics:damping = 0.01
        float drive:rotX:physics:maxForce = 0.08
        float drive:rotX:physics:stiffness = 0.15
        float drive:rotX:physics:targetPosition = 0
        uniform token drive:rotX:physics:type = "force"
        float drive:rotY:physics:damping = 0.01
        float drive:rotY:physics:maxForce = 0.08
        float drive:rotY:physics:stiffness = 0.15
